# OpenHarness Enterprise 配置文件
# 复制此文件为 .env 并修改配置

# ===========================================
# LLM 配置 (必填)
# ===========================================

# LLM API Token (必填)
ANTHROPIC_AUTH_TOKEN=your-api-key-here

# LLM API 地址 (可选，使用百炼时填写)
ANTHROPIC_BASE_URL=https://coding.dashscope.aliyuncs.com/apps/anthropic

# LLM 模型名称
ANTHROPIC_MODEL=glm-5

# ===========================================
# 服务配置 (可选)
# ===========================================

# 服务端口
PORT=8000

# 服务地址
HOST=0.0.0.0

# ===========================================
# 安全配置 (可选)
# ===========================================

# JWT 密钥 (用于生成 Token，建议修改)
JWT_SECRET=your-secret-key-change-me

# Token 过期时间 (小时)
TOKEN_EXPIRE_HOURS=24

# ===========================================
# REST API 工具配置 (可选)
# ===========================================

# REST API Token (用于 rest_api_call 工具)
# REST_API_TOKEN=your-rest-api-token